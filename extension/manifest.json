{
  "manifest_version": 3,
  "name": "PhishGuard — Real-Time Phishing Threat Intelligence",
  "version": "1.2.0",
  "description": "Instant AI phishing detection and threat analysis browser extension matching PhishGuard aesthetic.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:5000/*",
    "http://localhost:5000/*",
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "PhishGuard Threat Protection"
  },
  "background": {
    "service_worker": "background.js"
  }
}
